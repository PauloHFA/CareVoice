# Copy to .env for local development. Never commit real tokens or encryption keys.
CAREVOICE_ENVIRONMENT=development
CAREVOICE_TRANSCRIBER=local
CAREVOICE_CLOUD_PROCESSING_ENABLED=false
CAREVOICE_REAL_DATA_ENABLED=false
CAREVOICE_PSEUDONYMIZE_BEFORE_LLM=true
CAREVOICE_DEFAULT_TIMEZONE=America/Fortaleza
CAREVOICE_MAX_AUDIO_MB=20
CAREVOICE_MAX_AUDIO_SECONDS=300
CAREVOICE_AUDIO_RETENTION_DAYS=0
CAREVOICE_TRANSCRIPT_RETENTION_DAYS=30

# Configure secrets only in a local secret store or deployment secret manager.
# CAREVOICE_TELEGRAM_BOT_TOKEN=
# CAREVOICE_FIELD_ENCRYPTION_KEY=
# CAREVOICE_ADMINISTRATOR_CHAT_ID=
# CAREVOICE_DATABASE_URL=postgresql+psycopg://user:password@localhost/carevoice
